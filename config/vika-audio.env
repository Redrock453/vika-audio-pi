# Vika Audio Pi runtime paths and policy.
# Installed path: /etc/vika-audio/vika-audio.env (created only if missing,
# so local edits survive re-runs of scripts/install.sh).
#
# No secrets belong in this file. It is world-readable on purpose.

VIKA_USER="vika"

# Library root. Everything MPD may play must live below this directory.
VIKA_MUSIC_DIR="/home/vika/media"
VIKA_LOCAL_SUBDIRS="music audiobooks"

# Ordinary USB flash is mounted read-only here by scripts/usb-media.sh.
# This path must stay inside VIKA_MUSIC_DIR.
VIKA_MOUNT_POINT="/home/vika/media/usb"

# MPD state (owned by the service user, provisioned by systemd StateDirectory).
VIKA_PLAYLIST_DIR="/var/lib/vika-audio/playlists"
VIKA_STATE_DIR="/var/lib/vika-audio/state"
VIKA_MPD_HOST="/run/vika-audio/mpd.sock"
VIKA_MPC_BIN="/usr/bin/mpc"

# Extensions treated as audio. Anything else is ignored, not deleted.
VIKA_AUDIO_EXT="mp3 flac ogg oga opus m4a m4b aac wav wave aif aiff wma wv ape"

# 1 = start playing at boot (requested behaviour), 0 = restore and stay paused.
VIKA_BOOT_AUTOPLAY="1"

# How long boot-play waits for MPD and for the USB mount before choosing local.
VIKA_MPD_WAIT_SECONDS="60"
VIKA_USB_BOOT_WAIT_SECONDS="15"

# Optional: pin one block device instead of auto-detecting, for example
#   VIKA_USB_DEVICE="/dev/disk/by-label/VIKA_AUDIO"
# Leave empty for automatic detection (one removable partition, or the one
# labelled VIKA_AUDIO).
VIKA_USB_DEVICE=""
